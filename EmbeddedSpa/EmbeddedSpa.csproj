<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Automatically embed all files from wwwroot -->
  <Target Name="EmbedWwwroot" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <EmbeddedResource Include="wwwroot/**/*" Condition="Exists('wwwroot')">
        <LogicalName>wwwroot.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
